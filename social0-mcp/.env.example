# Social0 API key (create at https://social0.app/settings/api-keys)
SOCIAL0_API_KEY=s0_live_your_key_here

# API base URL — use /v1 suffix for v1 REST endpoints; /api paths are resolved automatically
SOCIAL0_API_URL=https://api.social0.app/v1

# Set to "true" for request/response logging on stderr
SOCIAL0_MCP_VERBOSE=false

# Request timeout in milliseconds (default: 30000)
SOCIAL0_REQUEST_TIMEOUT_MS=30000

# Max retries on HTTP 429 (default: 3)
SOCIAL0_MAX_RETRIES=3
