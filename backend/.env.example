# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Redis (BullMQ) — docker compose up -d redis
REDIS_URL=redis://127.0.0.1:6379

# Database (same Neon URL as frontend)
DATABASE_URL=postgresql://...

# ── Better Auth (user login) ─────────────────────────────────────────────
BETTER_AUTH_SECRET=                          # min 32 chars
BETTER_AUTH_URL=http://localhost:3001        # backend URL when standalone
NEXT_PUBLIC_APP_URL=http://localhost:3000    # frontend URL for OAuth redirects

# Google OAuth (sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email OTP (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Social0 <noreply@yourdomain.com>

# Token encryption (64 hex chars = 32 bytes) — MUST match frontend
ENCRYPTION_KEY=

# Cloudflare Turnstile (production sign-up)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis (optional — session cache + rate limits)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Platform OAuth (connect flows) ───────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_LOGIN_CONFIG_ID=
FACEBOOK_INSTAGRAM_LOGIN_CONFIG_ID=
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=

# Cloudflare R2 (media uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PUBLIC_URL=

# Worker concurrency
WORKER_PLATFORM_CONCURRENCY=20
WORKER_EMAIL_CONCURRENCY=10

# Cron
CRON_SECRET=

# Dev / E2E only
ALLOW_TEST_SIGNIN=false
TEST_USER_ID=
TEST_USER_EMAIL=
TEST_USER_NAME=

# Worker stub testing
WORKER_STUB_FAIL=0
