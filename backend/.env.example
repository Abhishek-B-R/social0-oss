# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Upstash Redis - single instance for BullMQ queues, rate limits, auth cache, pub/sub
# Create at https://console.upstash.com (free tier works for local dev)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: rediss:// URL from Upstash "Redis Connect" tab (auto-derived from REST creds if omitted)
# UPSTASH_REDIS_URL=

# Database (same Neon URL as frontend)
DATABASE_URL=postgresql://...
# Direct Neon host for drizzle-kit migrate (optional; we strip -pooler from DATABASE_URL if omitted)
# DATABASE_URL_UNPOOLED=postgresql://...

# ── Better Auth (user login) ─────────────────────────────────────────────
BETTER_AUTH_SECRET=                          # min 32 chars
# Auth API host — Google callback = ${AUTH_API_URL or api.social0.app}/api/auth/callback/google
# Do NOT set BETTER_AUTH_URL to dev.social0.app (that's the SPA). Use:
AUTH_API_URL=https://api.social0.app
BETTER_AUTH_URL=https://api.social0.app
# SPA origin(s) for post-login redirects only
NEXT_PUBLIC_APP_URL=https://dev.social0.app
APP_URL=https://dev.social0.app
# Browser CORS (optional override; default prod=https://social0.app, dev=+localhost:3000)
# CORS_ORIGINS=https://social0.app,https://localhost:3000
# Comma-separated frontend origins for OAuth/checkout return URLs
TRUSTED_APP_ORIGINS=https://social0.app,https://localhost:3000

# Google OAuth (sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email OTP (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=abhishek from social0 <abhishek@social0.app>

# Token encryption (64 hex chars = 32 bytes)
# MUST match frontend/.env.local ENCRYPTION_KEY (64 hex chars = 32 bytes AES-256).
ENCRYPTION_KEY=
# Rotating ENCRYPTION_KEY: put the new key above and the old one here (comma-separated,
# newest first) on the API and the publish worker. Old ciphertexts still decrypt; new
# writes use the new key. Remove an old key once nothing is encrypted with it.
# ENCRYPTION_KEYS_PREVIOUS=

# Cloudflare Turnstile (production sign-up)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Canny feedback (embedded board in dashboard; react-frontend reads board token via GET /api/canny/config)
NEXT_PUBLIC_CANNY_BOARD_TOKEN=          # Canny → Settings → Board → board token
CANNY_PRIVATE_KEY=                      # Canny → Settings → SSO → private key (HS256)

# Cloudflare Publish Worker — platform posting at the edge (recommended for production)
# Deploy: cloudflare/publish-worker/README.md
# PUBLISH_DISPATCH=server publishes every platform from this API process instead
# (no worker needed; good for local runs and self-hosting).
PUBLISH_DISPATCH=cloudflare
CF_PUBLISH_WORKER_URL=https://social0-publish.<account>.workers.dev
CF_PUBLISH_HMAC_SECRET=       # shared secret (wrangler secret put PUBLISH_HMAC_SECRET)
# X and TikTok publish on this API process, not the worker (see
# backend/shared/src/constants/server-side-publish.ts). The background worker
# hands those scheduled jobs back over HTTP, so it needs the API host and
# CRON_SECRET below. Defaults to AUTH_API_URL, then https://api.social0.app.
INTERNAL_API_BASE_URL=http://127.0.0.1:3001

# Cron
CRON_SECRET=
# Admin API (required in production): Bearer token for /admin/* and /metrics
ADMIN_API_KEY=
# Proxy hops in front of the API whose X-Forwarded-For entries are trusted for the
# client IP (rate limits). Default: 1 in production, off in dev. `true` = 1 hop,
# `false` = socket address only, a number = that many hops (e.g. 2 for
# Cloudflare -> nginx -> API), or a proxy-addr list like `loopback,10.0.0.0/8`.
# Never "trust all": the leftmost X-Forwarded-For entry is client-controlled.
# TRUST_PROXY=1
# Daily: POST /api/cron/billing-zombie-cleanup (Bearer CRON_SECRET) - cancels on_hold/pending/failed subs unpaid 15+ days
DODO_ZOMBIE_SUBSCRIPTION_GRACE_DAYS=15

# ── Platform OAuth (connect flows) ───────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_LOGIN_CONFIG_ID=
FACEBOOK_INSTAGRAM_LOGIN_CONFIG_ID=
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=

# Cloudflare R2 (media uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PUBLIC_URL=

# Cron (server enqueues 202 → background-worker): publish-scheduled, repost, autoplug, token-health, billing-zombie-cleanup
# After bumping LEGAL_VERSIONS: POST /api/cron/notify-legal-update with Authorization: Bearer $CRON_SECRET
#   202 = started in the background; 409 = a run is in progress; re-POST after a partial run mails only users not yet mailed

# Dodo Payments (monthly + yearly product IDs)
# DODO_PAYMENTS_API_KEY=
# DODO_PAYMENTS_WEBHOOK_SECRET=
# DODO_PAYMENTS_ENVIRONMENT=test_mode
# Plans sold today: Creator and Agency (+ Agency's per-account add-on).
# DODO_PAYMENTS_CREATOR_PRODUCT_ID=
# DODO_PAYMENTS_CREATOR_YEARLY_PRODUCT_ID=
# DODO_PAYMENTS_AGENCY_PRODUCT_ID=
# DODO_PAYMENTS_AGENCY_YEARLY_PRODUCT_ID=
# DODO_PAYMENTS_AGENCY_EXTRA_ACCOUNT_ADDON_ID=
# DODO_PAYMENTS_AGENCY_EXTRA_ACCOUNT_YEARLY_ADDON_ID=
# Legacy plans below are closed to new signups; keep their ids set so grandfathered customers still resolve.
# DODO_PAYMENTS_STARTER_PRODUCT_ID=
# DODO_PAYMENTS_GROWTH_PRODUCT_ID=
# DODO_PAYMENTS_PRO_PRODUCT_ID=
# DODO_PAYMENTS_STARTER_YEARLY_PRODUCT_ID=
# (legacy alias for starter yearly) DODO_PAYMENTS_LITE_YEARLY_PRODUCT_ID=
# DODO_PAYMENTS_GROWTH_YEARLY_PRODUCT_ID=
# DODO_PAYMENTS_PRO_YEARLY_PRODUCT_ID=
# DODO_PAYMENTS_MAX_PRODUCT_ID=
# DODO_PAYMENTS_MAX_YEARLY_PRODUCT_ID=

# Hosted MCP (Claude Connectors / mcp.social0.app)
MCP_BASE_URL=https://mcp.social0.app
# Shared with cloudflare/mcp-worker: token introspection, and verifying the
# caller address it forwards for the /oauth/register + /oauth/authorize limits.
MCP_OAUTH_INTROSPECT_SECRET=

# Dev / E2E only
ALLOW_TEST_SIGNIN=false
TEST_USER_ID=
TEST_USER_EMAIL=
TEST_USER_NAME=
