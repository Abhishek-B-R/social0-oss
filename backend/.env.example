# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Upstash Redis — single instance for BullMQ queues, rate limits, auth cache, pub/sub
# Create at https://console.upstash.com (free tier works for local dev)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: rediss:// URL from Upstash "Redis Connect" tab (auto-derived from REST creds if omitted)
# UPSTASH_REDIS_URL=

# Database (same Neon URL as frontend)
DATABASE_URL=postgresql://...

# ── Better Auth (user login) ─────────────────────────────────────────────
BETTER_AUTH_SECRET=                          # min 32 chars
# React dev (Vite proxy): BETTER_AUTH_URL must match NEXT_PUBLIC_APP_URL (SPA origin).
# With mkcert in backend/certificates/: use https://localhost:3000
# Google OAuth redirect URI: https://localhost:3000/api/auth/callback/google
BETTER_AUTH_URL=https://localhost:3000
NEXT_PUBLIC_APP_URL=https://localhost:3000

# Google OAuth (sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email OTP (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Social0 <noreply@yourdomain.com>

# Token encryption (64 hex chars = 32 bytes)
# MUST match frontend/.env.local ENCRYPTION_KEY (Next.js uses .env.local in dev).
ENCRYPTION_KEY=

# Cloudflare Turnstile (production sign-up)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare Publish Worker — social post processing at the edge (not inline in API)
# Deploy: cloudflare/publish-worker/README.md
# PUBLISH_DISPATCH=cloudflare   # force CF; omit or bullmq for local BullMQ droplet
# CF_PUBLISH_WORKER_URL=https://social0-publish.<account>.workers.dev
# CF_PUBLISH_HMAC_SECRET=       # shared secret (wrangler secret put PUBLISH_HMAC_SECRET)

# Cron
CRON_SECRET=

# ── Platform OAuth (connect flows) ───────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_LOGIN_CONFIG_ID=
FACEBOOK_INSTAGRAM_LOGIN_CONFIG_ID=
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=

# Cloudflare R2 (media uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PUBLIC_URL=

# Worker concurrency
WORKER_PLATFORM_CONCURRENCY=20
WORKER_EMAIL_CONCURRENCY=10

# Dev / E2E only
ALLOW_TEST_SIGNIN=false
TEST_USER_ID=
TEST_USER_EMAIL=
TEST_USER_NAME=

# Worker stub testing
WORKER_STUB_FAIL=0
