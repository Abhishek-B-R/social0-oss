{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": "./src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "src/lib/platform-icons.tsx",
    "src/lib/remembered-accounts.ts",
    "src/lib/remembered-autorepost-autoplug.ts",
    "src/lib/rpc.ts",
    "src/lib/auth-client.ts",
    "src/lib/composer-bridge.ts",
    "src/lib/utils.ts",
    "src/lib/preconnect.ts",
    "src/lib/sign-in-url.ts",
    "src/lib/docs-url.ts"
  ],
  "references": [{ "path": "../shared" }]
}
