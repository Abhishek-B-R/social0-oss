{
  "name": "social0-mcp-worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild:mcp": "npm run build --prefix ../../../mcp",
    "dev": "npm run prebuild:mcp && wrangler dev",
    "deploy": "npm run prebuild:mcp && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "npm run prebuild:mcp && tsc --noEmit",
    "check": "npm run typecheck && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@social0/mcp": "file:../../../mcp",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "typescript": "^5.8.3",
    "wrangler": "^4.14.0"
  }
}
