# Hashed Vite assets are immutable — long cache is safe.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Always revalidate shell HTML so browsers don't keep stale script hashes.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# CLI installer must be returned as a shell script, not HTML.
/install.sh
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

/*
  Cache-Control: public, max-age=0, must-revalidate
