# API base URL for the browser client (required in production builds).
# Dev: leave empty — Vite proxies /api and /v1 to the backend (see VITE_API_PROXY_TARGET).
# Prod (dev.social0.app, social0.app): set to the Fastify API host.
VITE_API_URL=https://api.social0.app

# Where Vite proxies /api and /v1 in dev.
# Default: https://localhost:3001 when mkcert files exist in backend/certificates/, else http.
# VITE_API_PROXY_TARGET=https://localhost:3001

# Public app URL (OAuth redirects, Better Auth client, SEO canonical URLs)
# Use https when running Vite with mkcert certs (backend/certificates/).
VITE_APP_URL=https://localhost:3000

# Docs site base URL (optional)
# VITE_DOCS_URL=https://docs.social0.app

# Cloudflare Turnstile site key (email sign-up)
VITE_TURNSTILE_SITE_KEY=

# Canny feedback — board token is read from the API (/api/canny/config) using backend NEXT_PUBLIC_CANNY_BOARD_TOKEN.
# Optional local override (skips config fetch when set):
# VITE_CANNY_BOARD_TOKEN=

# Dodo Payments product IDs for billing tier mapping (optional)
# VITE_DODO_PAYMENTS_STARTER_PRODUCT_ID=
# VITE_DODO_PAYMENTS_GROWTH_PRODUCT_ID=
# VITE_DODO_PAYMENTS_PRO_PRODUCT_ID=
# VITE_DODO_PAYMENTS_STARTER_YEARLY_PRODUCT_ID=
# VITE_DODO_PAYMENTS_GROWTH_YEARLY_PRODUCT_ID=
# VITE_DODO_PAYMENTS_PRO_YEARLY_PRODUCT_ID=

# PostHog (required for production analytics — baked in at `vite build`)
# Also set these in Cloudflare Pages → Settings → Environment variables.
# VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_...
# VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
